<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="OMS.Presentation.MainWindow"
        Title="omsproj">

    <TabControl Name="MainTabControl">
        <TabItem Header="Login" Name="LoginTab" Background="DarkOrange">
            <SplitView IsPaneOpen="True" DisplayMode="Inline" OpenPaneLength="250">
                <SplitView.Pane>
                    <StackPanel Margin="20">
                        <TextBlock Text="Username:"/>
                        <TextBox Name="UsernameBox" Margin="0,5" Width="200" HorizontalAlignment="Left"/>
                        <Grid RowDefinitions="*" ColumnDefinitions="*, *">
                            <TextBlock Grid.Column="0" Grid.Row="0" VerticalAlignment="Bottom" Text="Password:"/>
                            <CheckBox Content="Show" HorizontalAlignment="Right" Grid.Row="0" Grid.Column="1"></CheckBox>
                        </Grid>
                        <TextBox Name="PasswordBox" Margin="0,5" Width="200" HorizontalAlignment="Left"/>
                        <Button Content="Login" Click="login_Button" Margin="0,10" Width="200" HorizontalContentAlignment="Center"/>
                        <TextBlock Text="forgot password?" FontSize="10" HorizontalAlignment="Center" Foreground="DarkOrange" Margin="10"></TextBlock>
                        <TextBlock Name="LoginStatus" Foreground="Red" FontSize="10" Margin="10"/>
                    </StackPanel>
                    </SplitView.Pane>
            </SplitView>

            
        </TabItem>
        
        <TabItem Header="Order Overview" Name="MainTab" >
            <SplitView IsPaneOpen="True" DisplayMode="Inline" OpenPaneLength="200">
                <SplitView.Pane>
                    <Grid RowDefinitions="30,30,30,30,30,30,30,30,30,30,30,30" ColumnDefinitions="Auto">
                        <TextBlock Grid.Row="0" Text="Sorting"
                                   FontSize="24"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Left"/>
                        <TextBox Grid.Row="1" Margin="0,5,0,10" Watermark="Search" Name="searchbox" KeyDown="Searchbox_OnKeyDown"></TextBox>
                        <TextBlock Margin="0,10,0,10" Grid.Row="2">By price:</TextBlock>
                        <Button Grid.Row="3" Content="Low to high" Click="Sortbyprice_lowtohigh" />
                        <Button Grid.Row="4" Content="High to low" Click="sortbyprice_hightolow"/>
                        <TextBlock Margin="0,10,0,10" Grid.Row="5">By date:</TextBlock>
                        <Button Grid.Row="6" Content="Latest" Click="SortByDate_NewestFirst"/>
                        <Button Grid.Row="7" Content="Oldest" Click="SortByDate_OldestFirst"/>
                        <TextBlock Margin="0,10,0,10" Grid.Row="8">By product amount:</TextBlock>
                        <Button Grid.Row="9" Content="Large amount" Click="sortbyamount_Large"/>
                        <Button Grid.Row="10" Content="Low amount" Click="sortbyamount_low"/>
                    </Grid>
                                    
                </SplitView.Pane>
               <StackPanel>
                   <Button Name="Refreshbutton" Click="referesh_button" Content="Refresh" Margin="20 1 1 1" ></Button>                 
                   <Border Margin="25 25 25 0" BorderBrush="DarkOrange" BorderThickness="1" CornerRadius="3 3 3 3">
                    <Grid Margin="10" RowDefinitions="*" ColumnDefinitions="5* 6* 5* 5* 4* 4* 4*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <TextBlock Grid.Row="0" Grid.Column="0">OrderId</TextBlock>
                        <TextBlock Grid.Row="0" Grid.Column="1">CustomerID</TextBlock>
                        <TextBlock Grid.Row="0" Grid.Column="2">ProductID</TextBlock>
                        <TextBlock Grid.Row="0" Grid.Column="3">Amount</TextBlock>
                        <TextBlock Grid.Row="0" Grid.Column="4">Price</TextBlock>
                        <TextBlock Grid.Row="0" Grid.Column="5">State</TextBlock>
                        <TextBlock Grid.Row="0" Grid.Column="6">Date</TextBlock>
                    </Grid>
                </Border>
                <Border MaxHeight="800" Margin="25 0 25 50" BorderBrush="DarkOrange" BorderThickness="1 0 1 1" CornerRadius="3 3 3 3">
                    <ScrollViewer>
                        <Grid Name="OrderGrid" Margin="10" ColumnDefinitions="5* 6* 5* 5* 4* 4* 4*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"></Grid>
                    </ScrollViewer>
                </Border>
               </StackPanel>
            </SplitView> 
        </TabItem>
    </TabControl>
</Window>
