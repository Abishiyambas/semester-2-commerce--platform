<UserControl
    Width="1400"
    x:Class="SHOP.Views.CartView"
    x:DataType="vm:CartViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:vm="clr-namespace:SHOP.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="10">
        <!--  Heading  -->
        <Grid ColumnDefinitions="*,*" RowDefinitions="*">
            <TextBlock
                FontSize="24"
                FontWeight="Bold"
                Grid.Column="0"
                Grid.Row="0"
                HorizontalAlignment="Left"
                Margin="20"
                Text="Cart" />
            <Button Grid.Column="1"
                Command="{Binding GoToOrderHistory}"
                IsVisible="{Binding UserLoggedIn}"
                Content="Order History"
                Foreground="White"
                Grid.Row="1"
                Height="41.66"
                HorizontalAlignment="Right"
                Margin="20"
                VerticalAlignment="Center"
                Width="125">
                <Button.Background>
                    <LinearGradientBrush EndPoint="100%, 50%" StartPoint="0%, 50%">
                        <GradientStop Color="Black" Offset="0" />
                        <GradientStop Color="DarkGray" Offset="0.5" />
                        <GradientStop Color="Gray" Offset="1" />
                    </LinearGradientBrush>
                </Button.Background>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="50">
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            
        </Grid>

        <ItemsControl ItemsSource="{Binding CartItemList}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border
                        BorderThickness="1"
                        CornerRadius="25"
                        Margin="2"
                        Padding="5">
                        <Border.Background>
                            <LinearGradientBrush EndPoint="50%, 100%" StartPoint="50%, 0%">
                                <GradientStop Color="#A8E6CF" Offset="0" />
                                <GradientStop Color="#46CDCF" Offset="0.5" />
                                <GradientStop Color="#3D84A8" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <StackPanel>
                                <Grid ColumnDefinitions="*,*,*,*,*" RowDefinitions="*,*">
                                    <Border
                                        ClipToBounds="True"
                                        CornerRadius="25"
                                        Grid.Column="0"
                                        Grid.Row="0">
                                        <!--  This adds an affect to the product images in the cart casting a little shadow, we can play with offsets to the shadows if we want?  -->
                                        <Border.Effect>
                                            <DropShadowEffect
                                                BlurRadius="10"
                                                Color="Black"
                                                Opacity="0.4" />
                                        </Border.Effect>
                                        <Image
                                            Grid.Column="0"
                                            Grid.Row="0"
                                            Height="100"
                                            HorizontalAlignment="Left"
                                            Margin="10"
                                            Source="{Binding Products.ProductImage}"
                                            Stretch="UniformToFill"
                                            Width="100">
                                            <!--  This streches our picture to the and after the turn it into an Ellipse (making the picture round)  -->
                                            <Image.Clip>
                                                <RectangleGeometry
                                                    RadiusX="10"
                                                    RadiusY="10"
                                                    Rect="0,0,100,100" />
                                            </Image.Clip>
                                        </Image>
                                    </Border>
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Foreground="Black"
                                        Grid.Column="1"
                                        Grid.Row="0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                        <Run Text="{Binding Products.Name}" />
                                        <LineBreak />
                                        <Run
                                            FontWeight="Light"
                                            Foreground="Gray"
                                            Text="EAN: " />
                                        <Run
                                            FontWeight="Light"
                                            Foreground="Gray"
                                            Text="{Binding Products.EAN_Number}" />
                                    </TextBlock>
                                    <Grid
                                        ColumnDefinitions="*,*,*"
                                        Grid.Column="2"
                                        Grid.Row="0"
                                        RowDefinitions="*">
                                        <Button
                                            Click="Button_OnClick"
                                            Content="-"
                                            Grid.Column="0"
                                            Grid.Row="0"
                                            Height="25"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Width="25">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="17.5">
                                                        <ContentPresenter
                                                            Content="{TemplateBinding Content}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!--  Remember to bind  -->
                                        <Label
                                            Background="Gray"
                                            Content="{Binding Count}"
                                            Grid.Column="1"
                                            Grid.Row="0"
                                            Height="25"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Width="50">
                                            <Label.Template>
                                                <ControlTemplate TargetType="Label">
                                                    <Border
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="50">
                                                        <ContentPresenter
                                                            Content="{TemplateBinding Content}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Label.Template>
                                        </Label>
                                        <Button
                                            Click="AddProduct"
                                            Content="+"
                                            Grid.Column="2"
                                            Grid.Row="0"
                                            Height="25"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Width="25">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="17.5">
                                                        <ContentPresenter
                                                            Content="{TemplateBinding Content}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                    <TextBlock
                                        Grid.Column="3"
                                        Grid.Row="0"
                                        Text="{Binding Products.Price}"
                                        VerticalAlignment="Center" />
                                    <Button
                                        Background="Transparent"
                                        Click="ClearProduct"
                                        Grid.Column="4"
                                        Grid.Row="0">
                                        <Image
                                            Height="25"
                                            Source="avares://SHOP/Assets/trashcan-removebg-preview.png"
                                            Width="25" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid ColumnDefinitions="*" RowDefinitions="*,*">
            <TextBlock HorizontalAlignment="Right">
                <Run Text="Total Amount" />
                <Run Text="{Binding TotalPrice, StringFormat='{}{0:F2} dkk.'}" />
                <LineBreak />
                <Run
                    FontWeight="Light"
                    Foreground="Gray"
                    Text="Including VAT" />
                <Run FontWeight="Light" Foreground="Gray" />
                <Run Text="{Binding VatPrice, StringFormat='{}{0:F2} dkk.'}" />
            </TextBlock>
            <Button
                Command="{Binding GoToCheckout}"
                Content="Go to payment"
                Foreground="White"
                Grid.Row="1"
                Height="41.66"
                HorizontalAlignment="Right"
                Margin="20"
                VerticalAlignment="Center"
                Width="125">
                <Button.Background>
                    <LinearGradientBrush EndPoint="100%, 50%" StartPoint="0%, 50%">
                        <GradientStop Color="SeaGreen" Offset="0" />
                        <GradientStop Color="ForestGreen" Offset="0.5" />
                        <GradientStop Color="MediumSeaGreen" Offset="1" />
                    </LinearGradientBrush>
                </Button.Background>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="50">
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

    </StackPanel>
</UserControl>
