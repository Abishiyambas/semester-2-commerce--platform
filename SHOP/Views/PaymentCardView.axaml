<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="SHOP.Views.PaymentCardView"
    x:DataType="vm:PaymentCardViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:SHOP.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <Grid
            ColumnDefinitions="*,*,*"
            RowDefinitions="*,*"
            ShowGridLines="False">
            <Border
                Background="LightGray"
                CornerRadius="25"
                Grid.Column="0"
                Height="50"
                Margin="20"
                Width="50">
                <Label
                    Content="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>
            <TextBlock
                FontWeight="Bold"
                Grid.Column="0"
                Grid.Row="1"
                HorizontalAlignment="Center"
                Text="Delivery" />
            <Border
                Background="LightGray"
                CornerRadius="25"
                Grid.Column="1"
                Height="50"
                Margin="20"
                Width="50">
                <Label
                    Content="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>
            <TextBlock
                Grid.Column="1"
                Grid.Row="1"
                HorizontalAlignment="Center"
                Text="Overview" />
            <Border
                Background="LightGreen"
                CornerRadius="25"
                Grid.Column="2"
                Height="50"
                Margin="20"
                Width="50">
                <Label
                    Content="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>
            <TextBlock
                Grid.Column="2"
                Grid.Row="1"
                HorizontalAlignment="Center"
                Text="Payment" />
        </Grid>
        <TextBlock
            FontSize="30"
            HorizontalAlignment="Center"
            Text="Card Payment" />
        <Border
            BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="25"
            Height="400"
            Margin="0,20,0,0"
            Padding="5"
            Width="400">
            <StackPanel>
                <TextBlock
                    HorizontalAlignment="Left"
                    Margin="5"
                    Text="Card Number" />
                <TextBox x:Name="CardNumberTextBox" />
                <Label
                    Content=""
                    Foreground="DarkRed"
                    Name="CardNumberLabel" />
                <Grid ColumnDefinitions="*,*">
                    <TextBlock Grid.Column="0" Text="Expired date" />
                    <TextBlock Grid.Column="1" Text="CVV/CVD" />
                </Grid>
                <Grid ColumnDefinitions="Auto,Auto,Auto" ShowGridLines="True">
                    <TextBox
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Margin="0,0,5,0"
                        Name="MonthTextBox"
                        Watermark="MM"
                        Width="30" />
                    <TextBox
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        Name="YearTextBox"
                        Watermark="YY"
                        Width="30" />
                    <TextBox
                        Grid.Column="2"
                        Margin="55,0,0,0"
                        Name="CvvCvdTextBox"
                        Width="200" />
                </Grid>
                <Grid ColumnDefinitions="Auto,Auto">
                    <Label
                        Content=""
                        Foreground="DarkRed"
                        Name="ExpiryDateLabel" />
                    <Label
                        Content=""
                        Foreground="DarkRed"
                        Grid.Column="1"
                        Margin="75,0,0,0"
                        Name="CvvCvdLabel" />
                </Grid>
                <Button
                    Click="PayButton_OnClick"
                    Content="{Binding Price, StringFormat='Pay {0} DKK'}"
                    Foreground="White"
                    Height="41.66"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="0,30,0,0"
                    Name="PayButton"
                    VerticalContentAlignment="Center">
                    <Button.Background>
                        <LinearGradientBrush EndPoint="100%, 50%" StartPoint="0%, 50%">
                            <GradientStop Color="MediumSeaGreen" Offset="0" />
                            <GradientStop Color="SeaGreen" Offset="0.5" />
                            <GradientStop Color="ForestGreen" Offset="1" />
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>

            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
