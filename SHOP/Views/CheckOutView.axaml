<UserControl
    x:Class="SHOP.Views.CheckoutView"
    x:DataType="vm:CheckoutViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:vm="clr-namespace:SHOP.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <Grid
            ColumnDefinitions="*,*,*"
            RowDefinitions="*,*"
            ShowGridLines="False">
            <Border
                Background="LightGreen"
                CornerRadius="25"
                Grid.Column="0"
                Height="50"
                Margin="20"
                Width="50">
                <Label
                    Content="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>
            <TextBlock
                FontWeight="Bold"
                Grid.Column="0"
                Grid.Row="1"
                HorizontalAlignment="Center"
                Text="Delivery" />
            <Border
                Background="LightGray"
                CornerRadius="25"
                Grid.Column="1"
                Grid.Row="0"
                Height="50"
                Margin="20"
                Width="50">
                <Label
                    Content="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>
            <TextBlock
                Grid.Column="1"
                Grid.Row="1"
                HorizontalAlignment="Center"
                Text="Overview" />
            <Border
                Background="LightGray"
                CornerRadius="25"
                Grid.Column="2"
                Grid.Row="0"
                Height="50"
                Margin="20"
                Width="50">
                <Label
                    Content="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>
            <TextBlock
                Grid.Column="2"
                Grid.Row="1"
                HorizontalAlignment="Center"
                Text="Payment" />
        </Grid>

        <Grid
            ColumnDefinitions="400,400"
            HorizontalAlignment="Center"
            Margin="20"
            RowDefinitions="*,*">
            <Border
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="25"
                Padding="5">
                <Border.Background>
                    <LinearGradientBrush EndPoint="50%, 100%" StartPoint="50%, 0%">
                        <GradientStop Color="#A8E6CF" Offset="0" />
                        <GradientStop Color="#46CDCF" Offset="0.5" />
                        <GradientStop Color="#3D84A8" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Grid.Column="0">
                    <TextBlock
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0"
                        Text="Billing address" />
                    <!--  Nogle af tekst boksene SKAL udfyldes, hvis ikke skal den alarmere.  -->
                    <!--  Måske der skal være en valgmulighed i forhold til at logge ind her?  -->
                    <TextBlock Margin="0,20,0,10" Text="First and last name*" />
                    <TextBox
                        CornerRadius="25"
                        Name="NameTextBox"
                        Text="{Binding Name}" />
                    <Label
                        Content=""
                        Foreground="DarkRed"
                        Name="NameErrorLabel" />
                    <TextBlock Margin="0,20,0,10" Text="Address*" />
                    <TextBox
                        CornerRadius="25"
                        Name="AddressTextBox"
                        Text="{Binding Address}" />
                    <Label
                        Content=""
                        Foreground="DarkRed"
                        Name="AddressErrorLabel" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="*,*,*">
                        <TextBlock
                            Grid.Column="0"
                            Grid.Row="0"
                            Margin="0,20,0,10"
                            Text="Postal code*" />
                        <Label
                            Content=""
                            Foreground="DarkRed"
                            Grid.Column="0"
                            Grid.Row="2"
                            Name="PostalCodeErrorLabel" />
                        <TextBox
                            CornerRadius="25"
                            Grid.Column="0"
                            Grid.Row="1"
                            HorizontalAlignment="Left"
                            Name="PostalCodeTextBox"
                            GotFocus="ClearOnFocus"
                            Text="{Binding PostalCode}"
                            Width="100" />
                        <TextBlock
                            Grid.Column="1"
                            Grid.Row="0"
                            HorizontalAlignment="Left"
                            Margin="20,20,0,10"
                            Text="City*" />
                        <Label
                            Content=""
                            Foreground="DarkRed"
                            Grid.Column="1"
                            Grid.Row="2"
                            HorizontalAlignment="Left"
                            Margin="18,0,0,0"
                            Name="CityErrorLabel" />
                        <TextBox
                            CornerRadius="25"
                            Grid.Column="1"
                            Grid.Row="1"
                            HorizontalAlignment="Left"
                            Margin="18,0,0,0"
                            Name="CityTextBox"
                            GotFocus="ClearOnFocus"
                            Text="{Binding City}"
                            Width="150" />
                    </Grid>
                    <TextBlock Margin="0,20,0,10" Text="Country*" />
                    <TextBox
                        CornerRadius="25"
                        Name="CountryTextBox"
                        Text="{Binding Country}" />
                    <Label
                        Content=""
                        Foreground="DarkRed"
                        Name="CountryErrorLabel" />
                    <TextBlock Margin="0,20,0,10" Text="Telephone(+45)*" />
                    <TextBox
                        CornerRadius="25"
                        Name="TelephoneTextBox"
                        Text="{Binding Telephone}" />
                    <Label
                        Content=""
                        Foreground="DarkRed"
                        Name="TelephoneErrorLabel" />
                    <TextBlock Margin="0,20,0,10" Text="E-mail*" />
                    <TextBox
                        CornerRadius="25"
                        Name="EmailTextBox"
                        Text="{Binding Email}" />
                    <Label
                        Content=""
                        Foreground="DarkRed"
                        Name="EmailErrorLabel" />
                </StackPanel>
            </Border>
            <Border
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="25"
                Grid.Row="1"
                Margin="0,20,0,0"
                Padding="5">
                <Border.Background>
                    <LinearGradientBrush EndPoint="50%, 100%" StartPoint="50%, 0%">
                        <GradientStop Color="#A8E6CF" Offset="0" />
                        <GradientStop Color="#46CDCF" Offset="0.5" />
                        <GradientStop Color="#3D84A8" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0"
                        Text="Delivery form" />
                    <!--  RadioButton skal kunne ændre på den samlede pris, derfor skal de vel bindes på en måde?  -->
                    <RadioButton Checked="RadioButton_OnClick" Name="HomeDeliveryButton">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="192" />
                                <!--  Luft  -->
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Home Delivery" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                Text="50 kr." />
                        </Grid>
                    </RadioButton>
                    <RadioButton Checked="RadioButton_OnClick" Name="ParcelShopDeliveryButton">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <!--  Luft  -->
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Parcel Shop Delivery" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                Text="40 kr." />
                        </Grid>
                    </RadioButton>
                    <RadioButton Checked="RadioButton_OnClick" Name="CollectInStoreButton">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="192" />
                                <!--  Luft  -->
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Collect in store" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                Text="0 kr." />
                        </Grid>
                    </RadioButton>
                    <Label
                        Content=""
                        Foreground="DarkRed"
                        Name="RadioButtonIsNotChecked" />
                </StackPanel>
            </Border>

            <Border
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="25"
                Grid.Column="1"
                Margin="20,0,0,0"
                Padding="5">
                <Border.Background>
                    <LinearGradientBrush EndPoint="50%, 100%" StartPoint="50%, 0%">
                        <GradientStop Color="#A8E6CF" Offset="0" />
                        <GradientStop Color="#46CDCF" Offset="0.5" />
                        <GradientStop Color="#3D84A8" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Grid.Column="0">
                    <TextBlock
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,20"
                        Text="Your order" />

                    <ItemsControl ItemsSource="{Binding CartItemList}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    BorderThickness="0"
                                    CornerRadius="25"
                                    Margin="0,20,0,0"
                                    Padding="5">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="*,*">
                                            <Image
                                                Grid.Column="0"
                                                Height="50"
                                                HorizontalAlignment="Left"
                                                Source="{Binding Products.ProductImage}"
                                                Stretch="UniformToFill"
                                                Width="50">
                                                <Image.Clip>
                                                    <!--  This makes it so our pictures have rounded edges in checkout view  -->
                                                    <RectangleGeometry
                                                        RadiusX="10"
                                                        RadiusY="10"
                                                        Rect="0,0,50,50" />
                                                </Image.Clip>
                                            </Image>

                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="Bold"
                                                Foreground="Black"
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                                <Run Text="{Binding Products.Name}" />
                                                <LineBreak />
                                                <Run
                                                    FontWeight="ExtraLight"
                                                    Foreground="Gray"
                                                    Text="EAN: " />
                                                <Run
                                                    FontWeight="ExtraLight"
                                                    Foreground="Gray"
                                                    Text="{Binding Products.EAN_Number}" />
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding Count}" />
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding Products.Price, StringFormat='{}{0:F2} dkk.'}" />

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border
                        Background="Black"
                        Height="1"
                        Margin="0,10" />
                    <Grid ColumnDefinitions="*,*">
                        <TextBlock
                            FontWeight="Heavy"
                            Grid.Column="0"
                            Text="Subtotal" />
                        <TextBlock
                            FontWeight="Bold"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Text="{Binding TotalPrice, StringFormat='{}{0:F2} dkk.'}" />
                    </Grid>
                    <!--  Bindingen skal tilpasse til leverings omkostningerne  -->
                    <Border
                        Background="Black"
                        Height="1"
                        Margin="0,10" />
                    <Grid ColumnDefinitions="*,*">
                        <TextBlock
                            FontWeight="Light"
                            Grid.Column="0"
                            Text="Delivery" />
                        <TextBlock
                            FontWeight="Light"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Text="{Binding DeliveryPrice, StringFormat='{}{0:F2} dkk.'}" />
                    </Grid>
                    <Border
                        Background="Black"
                        Height="1"
                        Margin="0,10" />
                    <Grid ColumnDefinitions="*,*">
                        <TextBlock
                            FontWeight="Light"
                            Grid.Column="0"
                            Text="Total Price" />
                        <TextBlock
                            FontWeight="Light"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Text="{Binding PriceWithDelivery, StringFormat='{}{0:F2} dkk.'}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*">
                        <TextBlock
                            FontWeight="ExtraLight"
                            Foreground="DarkSlateGray"
                            Grid.Column="0"
                            Text="Total (VAT)" />
                        <TextBlock
                            FontWeight="ExtraLight"
                            Foreground="DarkSlateGray"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Text="{Binding VatPrice, StringFormat='{}{0:F2} dkk.'}" />
                        <Button
                            Click="Button_Overview_OnClick"
                            Content="Continue to overview"
                            Foreground="White"
                            Grid.Column="1"
                            Height="41.66"
                            HorizontalAlignment="Right"
                            Margin="0,30,0,0"
                            VerticalAlignment="Center"
                            Width="150">
                            <Button.Background>
                                <LinearGradientBrush EndPoint="100%, 50%" StartPoint="0%, 50%">
                                    <GradientStop Color="MediumSeaGreen" Offset="0" />
                                    <GradientStop Color="SeaGreen" Offset="0.5" />
                                    <GradientStop Color="ForestGreen" Offset="1" />
                                </LinearGradientBrush>
                            </Button.Background>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="50">
                                        <ContentPresenter
                                            Content="{TemplateBinding Content}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
