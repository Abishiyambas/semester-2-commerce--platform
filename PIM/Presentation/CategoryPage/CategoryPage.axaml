<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:PIM_Logic"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="PIM_Presentation.CategoriesPage">

    <StackPanel>
                
        <!-- Welcome Text -->
        <TextBlock x:Name="ActiveEmployeeTextBlock"
                   FontSize="25"
                   HorizontalAlignment="Left"
                   FontFamily="Segoe UI"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   Margin="10,10,0,0"
                   TextWrapping="Wrap">
            Welcome EmployeeName!
        </TextBlock>
        <!-- Welcome Text -->

        <!-- TOP GRID -->
        <Grid Margin="25 25 25 0" RowDefinitions="*" ColumnDefinitions="auto auto *">
            <!-- Søgefelt -->
            <StackPanel Orientation="Horizontal" Grid.Column="0" Spacing="10">
                <TextBox Name="SearchBox" Watermark="Search category..." Width="250" VerticalContentAlignment="Center" KeyUp="SearchBox_KeyUp"/>
                <Button Name="RefreshButton" Click="RefreshButtonHandler" Height="35" Width="35" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0" Margin="0" Background="Transparent" ToolTip.Tip="Reload all categories"/>
            </StackPanel>

            <Button Grid.Column="1" Margin="25 0 0 0" Content="Add Category" Click="AddCategoryHandler" CornerRadius="20" Background="LightSkyBlue" HorizontalAlignment="Left" ToolTip.Tip="Create a new product category"/>
            <Button Grid.Column="2" Background="Transparent"/>
        </Grid>


        <!-- HEADER -->
        <Border Margin="25 25 25 0" BorderBrush="Black" BorderThickness="1" CornerRadius="10 10 0 0">
            <Grid Margin="10" ColumnDefinitions="7* 5* 2* 2*">
                <TextBlock Grid.Column="0">Category Name</TextBlock>
                <TextBlock Grid.Column="1">Amount of Products</TextBlock>
                <TextBlock Grid.Column="2" ToolTip.Tip="Edit an existing category" >Edit</TextBlock>
                <TextBlock Grid.Column="3" ToolTip.Tip="Delete this category" >Delete</TextBlock>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <Border MaxHeight="350" Margin="25 0 25 50" BorderBrush="Black" BorderThickness="1 0 1 1" CornerRadius="0 0 10 10">
            <ScrollViewer>
                <StackPanel Name="CategoryStack" Margin="10"/>
            </ScrollViewer>
        </Border>
       

    </StackPanel>
</UserControl>