<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="550"
             x:Class="PIM_Presentation.EmployeesPage">
    <StackPanel>
        
        <!-- Welcome Text -->
        <TextBlock x:Name="ActiveEmployeeTextBlock"
                   FontSize="25"
                   HorizontalAlignment="Left"
                   FontFamily="Segoe UI"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   Margin="10,10,0,0"
                   TextWrapping="Wrap">
            Welcome EmployeeName!
        </TextBlock>
        <!-- Welcome Text -->
        
        <!-- Top Grid -->
        <Grid Margin="25 25 25 0" RowDefinitions="*" ColumnDefinitions="auto auto *">
            
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10">
                <TextBox Name="SearchBox" Watermark="Search..." Width="250" VerticalContentAlignment="Center" KeyUp="SearchBox_KeyUp"></TextBox>
                <Button Name="RefreshButton" Click="RefreshButtonHandler" Height="35" Width="35" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0" Margin="0" Background="Transparent" ToolTip.Tip="Reload all employees"></Button>
            </StackPanel>
            
            <Button Grid.Row="0" Grid.Column="2" Margin="25 0 0 0" CornerRadius="20" Background="LightSkyBlue" Click="AddEmployeeButtonHandler" ToolTip.Tip="Add a new employee" >Add Employee</Button>
        </Grid>
        
        <!-- Employee Grid -->
        <Border Margin="25,25,25,0" BorderBrush="Black" BorderThickness="1" CornerRadius="10,10,0,0">
            <Grid Margin="10" RowDefinitions="*" ColumnDefinitions="4* 4* 2* 2*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <TextBlock Grid.Row="0" Grid.Column="0">Name</TextBlock>
                <TextBlock Grid.Row="0" Grid.Column="1">Id</TextBlock>
                <TextBlock Grid.Row="0" Grid.Column="2">Edit</TextBlock>
                <TextBlock Grid.Row="0" Grid.Column="3">Delete</TextBlock>
            </Grid>
        </Border>
        <Border MaxHeight="450" Margin="25,0,25,50" BorderBrush="Black" BorderThickness="1,0,1,1" CornerRadius="0,0,10,10">
            <ScrollViewer>
                <Grid Name="EmployeeGrid" Margin="10" ColumnDefinitions="4* 4* 2* 2*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"></Grid>
            </ScrollViewer>
        </Border>
    </StackPanel>
</UserControl>
