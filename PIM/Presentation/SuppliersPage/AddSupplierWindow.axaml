<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="450" Height="250"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        x:Class="PIM_Presentation.AddSupplierWindow"
        Title="Add Supplier">

    <StackPanel Margin="20" Spacing="10">
    
        <TextBlock Text="Supplier name"/>
        <TextBox Name="SupplierNameBox" Watermark="Enter supplier name..."/>

        <TextBlock Text="Phone number"/>
        <TextBox Name="PhoneNumberBox" Watermark="Enter phone number..."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,10,0,0">
            <Button Name="CancelButton" Content="Cancel" Background="LightCoral" CornerRadius="25" Width="75" HorizontalContentAlignment="Center" Click="CancelButtonHandler"/>
            <Button Name="DoneButton" Content="Create" Background="LightGreen" CornerRadius="25" Width="75" HorizontalContentAlignment="Center" Click="DoneButtonHandler"/>
        </StackPanel>
        <DataGrid x:Name="SupplierGrid" AutoGenerateColumns="True"/>
    </StackPanel>
</Window>