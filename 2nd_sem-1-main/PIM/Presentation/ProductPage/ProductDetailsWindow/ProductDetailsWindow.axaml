<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PIM_Presentation.ProductDetailsWindow"
        Width="400" Height="600"
        Title="Product Details"
        WindowStartupLocation="CenterOwner">

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="15">
            <TextBlock Text="Product Details" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>

            <StackPanel>
                <TextBlock Text="Name:" FontWeight="Bold"/>
                <TextBlock x:Name="NameText"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Price:" FontWeight="Bold"/>
                <TextBlock x:Name="PriceText"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="SKU:" FontWeight="Bold"/>
                <TextBlock x:Name="SkuText"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Category:" FontWeight="Bold"/>
                <TextBlock x:Name="CategoryText"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Supplier:" FontWeight="Bold"/>
                <TextBlock x:Name="SupplierText"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Rating:" FontWeight="Bold"/>
                <TextBlock x:Name="RatingText"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Active:" FontWeight="Bold"/>
                <TextBlock x:Name="ActiveText"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Stock:" FontWeight="Bold"/>
                <TextBlock x:Name="StockText"/>
            </StackPanel>

            <TextBlock Text="Description" FontWeight="Bold"/>
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10">
                <TextBlock x:Name="DescriptionText" TextWrapping="Wrap"/>
            </Border>

            <TextBlock x:Name="CreationDateText" Margin="0,10,0,0"/>
            <TextBlock x:Name="LastUpdatedText"/>

            <Button Content="Done" HorizontalAlignment="Center" Background="lightgreen" Width="75" CornerRadius="25" HorizontalContentAlignment="Center" Click="CloseButton_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>
