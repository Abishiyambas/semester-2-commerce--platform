<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="SHOP.Views.OrderHistoryView"
    x:DataType="vm:OrderHistoryViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:SHOP.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock
            FontSize="30"
            FontWeight="Heavy"
            HorizontalAlignment="Center"
            Text="Order history" />
            <Border
                Width="700"
                BorderBrush="Black"
                BorderThickness="1"
                CornerRadius="25"
                Margin="20,0,0,0"
                Padding="5">
                <StackPanel>
                    <TextBlock
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,20"
                        Text="Your orders" />
                    <ItemsControl ItemsSource="{Binding OrderHistoryList}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    BorderThickness="0"
                                    CornerRadius="25"
                                    Margin="0,20,0,0"
                                    Padding="5">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="*,*,*,*,*">
                                            <Image
                                                Grid.Column="0"
                                                Height="50"
                                                HorizontalAlignment="Left"
                                                Source="{Binding Product.ProductImage}"
                                                Stretch="UniformToFill"
                                                Width="50">
                                                <Image.Clip>
                                                    <RectangleGeometry
                                                        RadiusX="10"
                                                        RadiusY="10"
                                                        Rect="0,0,50,50" />
                                                </Image.Clip>
                                            </Image>
                                            
                                            <TextBlock Grid.Column="1" Text="{Binding OrderDateOnly}"></TextBlock>
                                            
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="Bold"
                                                Foreground="Black"
                                                Grid.Column="2"
                                                HorizontalAlignment="Center">
                                                <Run Text="{Binding Product.Name}" />
                                                <LineBreak />
                                                <Run
                                                    FontWeight="ExtraLight"
                                                    Foreground="Gray"
                                                    Text="EAN: " />
                                                <Run
                                                    FontWeight="ExtraLight"
                                                    Foreground="Gray"
                                                    Text="{Binding Product.EAN_Number}" />
                                            </TextBlock>
                                            <TextBlock Grid.Column="3" HorizontalAlignment="Right" Text="{Binding Amount, StringFormat='Amount:{0}'}" />
                                            <TextBlock Grid.Column="4" HorizontalAlignment="Right" Text="{Binding Product.Price, StringFormat='{}{0:F2} dkk.'}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        
                    
        <Button
            Command="{Binding GoToHomeCommand}"
            Content="Go to homepage"
            Foreground="White"
            Height="41.66"
            HorizontalAlignment="Center"
            Margin="20"
            VerticalAlignment="Center"
            Width="150">
            <Button.Background>
                <LinearGradientBrush EndPoint="100%, 50%" StartPoint="0%, 50%">
                    <GradientStop Color="MediumSeaGreen" Offset="0" />
                    <GradientStop Color="SeaGreen" Offset="0.5" />
                    <GradientStop Color="ForestGreen" Offset="1" />
                </LinearGradientBrush>
            </Button.Background>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="50">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </StackPanel>
</UserControl>