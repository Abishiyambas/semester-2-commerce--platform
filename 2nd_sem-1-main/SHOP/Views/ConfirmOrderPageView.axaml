<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="SHOP.Views.ConfirmOrderPageView"
    x:DataType="vm:ConfirmOrderPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:SHOP.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock
            FontSize="30"
            FontWeight="Heavy"
            HorizontalAlignment="Center"
            Text="Thanks for your purchase!" />
        <TextBlock HorizontalAlignment="Center" Text="" />
        <Grid
            ColumnDefinitions="400,400"
            HorizontalAlignment="Center"
            Margin="20"
            RowDefinitions="*,*,*">
            <Border
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="25"
                Grid.Column="0"
                Margin="0,0,20,0"
                Padding="5">
                <StackPanel Grid.Column="0">
                    <TextBlock
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,20"
                        Text="Billing Address" />
                    <TextBlock
                        FontWeight="Light"
                        Margin="0,0,0,10"
                        Text="{Binding Name, StringFormat=Name:{0}}" />
                    <TextBlock
                        FontWeight="Light"
                        Margin="0,0,0,10"
                        Text="{Binding Address, StringFormat=Address:{0}}" />
                    <TextBlock
                        FontWeight="Light"
                        Margin="0,0,0,10"
                        Text="{Binding PostalCode, StringFormat=Postal Code:{0}}" />
                    <TextBlock
                        FontWeight="Light"
                        Margin="0,0,0,10"
                        Text="{Binding City, StringFormat=City:{0}}" />
                    <TextBlock
                        FontWeight="Light"
                        Margin="0,0,0,10"
                        Text="{Binding Country, StringFormat=Country:{0}}" />
                    <TextBlock
                        FontWeight="Light"
                        Margin="0,0,0,10"
                        Text="{Binding Telephone, StringFormat=Telephone:{0}}" />
                    <TextBlock
                        FontWeight="Light"
                        Margin="0,0,0,10"
                        Text="{Binding Email, StringFormat=Email:{0}}" />
                </StackPanel>
            </Border>
            <Border
                BorderBrush="Black"
                BorderThickness="1"
                CornerRadius="25"
                Grid.Column="1"
                Margin="20,0,0,0"
                Padding="5">
                <StackPanel Grid.Column="1">
                    <TextBlock
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,20"
                        Text="Your order" />
                    <ItemsControl ItemsSource="{Binding CartItemList}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    BorderThickness="0"
                                    CornerRadius="25"
                                    Margin="0,20,0,0"
                                    Padding="5">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="*,*">
                                            <Image
                                                Grid.Column="0"
                                                Height="50"
                                                HorizontalAlignment="Left"
                                                Source="{Binding Products.ProductImage}"
                                                Stretch="UniformToFill"
                                                Width="50">
                                                <Image.Clip>
                                                    <!--  This makes it so our pictures have rounded edges in checkout view  -->
                                                    <RectangleGeometry
                                                        RadiusX="10"
                                                        RadiusY="10"
                                                        Rect="0,0,50,50" />
                                                </Image.Clip>
                                            </Image>

                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="Bold"
                                                Foreground="Black"
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                                <Run Text="{Binding Products.Name}" />
                                                <LineBreak />
                                                <Run
                                                    FontWeight="ExtraLight"
                                                    Foreground="Gray"
                                                    Text="EAN: " />
                                                <Run
                                                    FontWeight="ExtraLight"
                                                    Foreground="Gray"
                                                    Text="{Binding Products.EAN_Number}" />
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding Count}" />
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding Products.Price, StringFormat='{}{0:F2} dkk.'}" />

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border
                        Background="Black"
                        Height="1"
                        Margin="0,10" />
                    <Grid ColumnDefinitions="*,*">
                        <TextBlock
                            FontWeight="Heavy"
                            Grid.Column="0"
                            Text="Subtotal" />
                        <TextBlock
                            FontWeight="Bold"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Text="{Binding TotalPrice, StringFormat='{}{0:F2} dkk.'}" />
                    </Grid>
                    <Border
                        Background="Black"
                        Height="1"
                        Margin="0,10" />
                    <Grid ColumnDefinitions="*,*">
                        <TextBlock
                            FontWeight="Light"
                            Grid.Column="0"
                            Text="Delivery" />
                        <TextBlock
                            FontWeight="Light"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Text="{Binding DeliveryPrice, StringFormat='{}{0:F2} dkk.'}" />
                    </Grid>
                    <Border
                        Background="Black"
                        Height="1"
                        Margin="0,10" />
                    <Grid ColumnDefinitions="*,*">
                        <TextBlock
                            FontWeight="Light"
                            Grid.Column="0"
                            Text="Total Price" />
                        <TextBlock
                            FontWeight="Light"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Text="{Binding PriceWithDelivery, StringFormat='{}{0:F2} dkk.'}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*">
                        <TextBlock
                            FontWeight="ExtraLight"
                            Foreground="DarkSlateGray"
                            Grid.Column="0"
                            Text="Total (VAT)" />
                        <TextBlock
                            FontWeight="ExtraLight"
                            Foreground="DarkSlateGray"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Text="{Binding VatPrice, StringFormat='{}{0:F2} dkk.'}" />
                    </Grid>

                </StackPanel>
            </Border>
        </Grid>
        <Button
            Command="{Binding GoToHomeCommand}"
            Content="Go to homepage"
            Foreground="White"
            Height="41.66"
            HorizontalAlignment="Center"
            Margin="20"
            VerticalAlignment="Center"
            Width="150">
            <Button.Background>
                <LinearGradientBrush EndPoint="100%, 50%" StartPoint="0%, 50%">
                    <GradientStop Color="MediumSeaGreen" Offset="0" />
                    <GradientStop Color="SeaGreen" Offset="0.5" />
                    <GradientStop Color="ForestGreen" Offset="1" />
                </LinearGradientBrush>
            </Button.Background>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="50">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </StackPanel>
</UserControl>
